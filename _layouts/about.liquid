---
layout: default
---
<div class="post about-page">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <div class="about-intro">
      {% if page.profile %}
        <aside class="profile about-profile" aria-labelledby="profile-name">
          <div class="profile-card">
            {% if page.profile.image %}
              {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
              {% assign profile_image_alt = page.profile.image_alt | default: 'Profile portrait' %}
              {% if page.profile.image_circular %}
                {% assign profile_image_class = 'img-fluid rounded-circle' %}
              {% else %}
                {% assign profile_image_class = 'img-fluid rounded' %}
              {% endif %}
              {% capture sizes %}(max-width: 200px) 80vw, 160px{% endcapture %}
              <div class="profile-portrait" style="--profile-image-position: {{ page.profile.image_position | default: '50% 50%' | escape }};">
                {%
                  include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_image_alt
                  cache_bust=true
                %}
              </div>
            {% endif %}
            <div class="profile-details">
              {% capture profile_full_name %}{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}{% endcapture %}
              <h2 class="profile-name" id="profile-name">{{ page.profile.name | default: profile_full_name | strip | escape }}</h2>
              <ul class="profile-contact" aria-label="Contact links">
                {% if site.data.socials.email %}
                  <li>
                    <a
                      class="profile-contact-link"
                      href="mailto:{{ site.data.socials.email | encode_email }}"
                      aria-label="Email: {{ site.data.socials.email | escape }}"
                    >
                      <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                      <span>{{ site.data.socials.email | escape }}</span>
                    </a>
                  </li>
                {% endif %}
                {% if page.profile.github_url %}
                  <li>
                    <a class="profile-contact-link" href="{{ page.profile.github_url | escape }}">
                      <i class="fa-brands fa-github" aria-hidden="true"></i>
                      <span>GitHub</span>
                    </a>
                  </li>
                {% endif %}
                {% if page.profile.linkedin_url %}
                  <li>
                    <a class="profile-contact-link" href="{{ page.profile.linkedin_url | escape }}">
                      <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
                      <span>LinkedIn</span>
                    </a>
                  </li>
                {% endif %}
              </ul>
              {{ page.profile.more_info }}
            </div>
          </div>
        </aside>
      {% endif %}

      <div class="about-biography">{{ content }}</div>
    </div>

    {% if page.achievements %}
      <section class="achievements" aria-labelledby="achievements-title">
        <h2 id="achievements-title">Achievements</h2>
        {% if page.achievements.size > 0 %}
          <div class="achievement-list">
            {% for achievement in page.achievements %}
              <article class="achievement-entry">
                {% if achievement.year %}
                  <div class="achievement-meta">
                    <span class="achievement-year">{{ achievement.year | escape }}</span>
                  </div>
                {% endif %}
                <div class="achievement-body">
                  <h3>{{ achievement.title | escape }}</h3>
                  <div class="achievement-description">{{ achievement.description | markdownify }}</div>
                </div>
              </article>
            {% endfor %}
          </div>
        {% endif %}
      </section>
    {% endif %}

    {% if page.projects and page.projects.size > 0 %}
      <section class="project-section" aria-labelledby="projects-title">
        <h2 id="projects-title">Projects</h2>
        <ul class="project-showcase">
          {% for project in page.projects %}
            <li>
              <a class="showcase-card" href="{{ project.url | relative_url | escape }}">
                <div class="showcase-heading">
                  <h3 class="showcase-title">{{ project.title | escape }}</h3>
                  <span class="showcase-destination">view project <span aria-hidden="true">↗</span></span>
                </div>
                <p class="showcase-description">{{ project.description | escape }}</p>
              </a>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
